{
  "manifest_version": 3,
  "name": "WA Bulk Sender + Contact Extractor",
  "author": "Chandresh Suvarna",
  "version": "5.0.0",
  "description": "Extract WhatsApp group contacts, then bulk-message them on WhatsApp Web with merge fields and attachments. Developed by Chandresh Suvarna.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WA Bulk Sender + Contact Extractor"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}